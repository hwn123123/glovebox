<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Use CDC-NCM for the regular USB tethering request. TETHERING_NCM itself
         is an Android local-only mode and therefore must not be used here. -->
    <integer name="config_tether_usb_functions">1</integer>
    <string-array name="config_tether_ncm_regexs">
        <item>usb\\d</item>
        <item>ncm\\d</item>
    </string-array>
    <string-array name="config_tether_usb_regexs">
        <item>rndis\\d</item>
    </string-array>
</resources>
