+func TestHysteria2CertificatePinDisablesChromeParrot(t *testing.T) {
+	content := `{"outbounds":[{"type":"hysteria2","tag":"pinned","server":"example.com","server_port":443,"password":"test","tls":{"enabled":true,"server_name":"example.com","certificate_pin_sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}},{"type":"hysteria2","tag":"standard","server":"example.net","server_port":443,"password":"test","tls":{"enabled":true,"server_name":"example.net"}}]}`
+	result, err := convert.Content(context.Background(), content, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pinned := result.Document.Outbounds[0].Options.(*option.Hysteria2OutboundOptions)
+	if !pinned.DisableChromeParrot {
+		t.Fatal("带证书钉扎的 Hysteria2 节点必须关闭 ChromeParrot")
+	}
+	standard := result.Document.Outbounds[1].Options.(*option.Hysteria2OutboundOptions)
+	if standard.DisableChromeParrot {
+		t.Fatal("普通 Hysteria2 节点不应改变 ChromeParrot 默认行为")
+	}
+}
