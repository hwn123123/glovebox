+// applyProtocolCompatibility 在持久化前消除已知的内核协议选项冲突。
+func applyProtocolCompatibility(document *provider.Document) {
+	for index := range document.Outbounds {
+		options, loaded := document.Outbounds[index].Options.(*option.Hysteria2OutboundOptions)
+		if !loaded || options.TLS == nil || options.TLS.CertificatePinSHA256 == "" {
+			continue
+		}
+		// ChromeParrot 不支持 tls.Config.VerifyConnection，而证书钉扎必须使用该回调。
+		options.DisableChromeParrot = true
+	}
+}
